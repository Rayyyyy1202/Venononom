# Copy this file to `.env` and fill in your real OpenAI key.
# .env is git-ignored.

# Required
OPENAI_API_KEY=sk-replace-me

# Model — defaults to gpt-5.4 per project requirement.
# If your account doesn't have access (you'll see "model_not_found" errors in
# the chat panel), change this to a model your key can call, e.g. gpt-4o-mini.
OPENAI_MODEL=gpt-5.4

# Optional — only set if you're using an OpenAI-compatible proxy
# (Azure OpenAI, OpenRouter, local Ollama, etc.). Leave blank for OpenAI direct.
# OPENAI_BASE_URL=https://api.openai.com/v1
